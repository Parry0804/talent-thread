# Copy this file to .env.local (for your computer) or paste each line into
# Vercel → Project → Settings → Environment Variables. See README.md for where to find each value.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console → API keys (powers AI portfolio reviews and job briefs)
ANTHROPIC_API_KEY=
# How many times each portfolio is scored (1–3). The median is kept. 3 is steadier but costs about 3x.
REVIEW_SAMPLES=1

# Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_ keys until you go live)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Account & Settings → Webhooks → the secret you typed when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Any long random string. Protects the daily auto-approve job.
CRON_SECRET=

# The address people use to reach the app, with no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000
